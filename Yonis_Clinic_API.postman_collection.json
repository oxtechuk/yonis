                    }
                },
                {
                    "name": "2️⃣ POST إنشاء وتثبيت الحجز (Initialize Booking)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const res = pm.response.json();",
                                    "if (res.booking_reference) {",
                                    "  pm.collectionVariables.set('booking_ref', res.booking_reference);",
                                    "  console.log('✅ New Booking Reference Saved:', res.booking_reference);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"service_id\": 1,\n  \"booking_type\": \"online\",\n  \"consultation_type\": \"video\",\n  \"payment_method\": \"zaincash\",\n  \"date\": \"2026-10-15\",\n  \"start_time\": \"10:00 AM\",\n  \"title\": \"استشارة نفسية متخصصة\",\n  \"notes\": \"أعاني من نوبات توتر أثناء العمل وضغوط يومية\",\n  \"name\": \"أحمد محمد عبد الله\",\n  \"phone\": \"+9647701234567\",\n  \"email\": \"ahmed@example.com\",\n  \"password\": \"password\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/checkout/initialize",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "checkout",
                                "initialize"
                            ]
                        },
                        "description": "إنشاء الحجز في النظام. يقوم بإنشاء مرجع الحجز (Booking Reference) وحفظه تلقائياً في متغير {{booking_ref}}. يقبل payment_method (zaincash, superki, card, stripe) ويرجع رمز الـ QR وتعليمات الدفع ورابط الواتساب للتأكيد."
                    }
                },
                {
                    "name": "3️⃣ POST تأكيد الدفع المحلي (زين كاش / سوبركي)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"booking_ref\": \"{{booking_ref}}\",\n  \"payment_method\": \"zaincash\",\n  \"transaction_reference\": \"TX-987654321\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/booking/{{booking_ref}}/confirm-payment",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "booking",
                                "{{booking_ref}}",
                                "confirm-payment"
                            ]
                        },
                        "description": "يقوم المريض بالضغط على 'أكدت الدفع' بعد مسح QR زين كاش أو سوبركي. يتحول الحجز إلى `PendingPaymentReview` بانتظار مراجعة الطبيب وتأكيده."
                    }
                },
                {
                    "name": "4️⃣ POST ويب هوك SpaceRemit التلقائي (Webhook Notification)",
