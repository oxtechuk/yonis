		{
			"name": "3. Booking & Checkout Engine",
			"item": [
				{
					"name": "Get Available Slots (جلب الأوقات المتاحة للحجز)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/slots?service_id=1&date=2026-08-25",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"slots"
							],
							"query": [
								{
									"key": "service_id",
									"value": "1",
									"description": "معرّف الجلسة"
								},
								{
									"key": "date",
									"value": "2026-08-25",
									"description": "التاريخ المطلوب (YYYY-MM-DD)"
								}
							]
						},
						"description": "حساب الأوقات المتاحة تلقائياً بخصم المواعيد المحجوزة مسبقاً وأوقات الراحة."
					},
					"response": []
				},
				{
					"name": "Step 1: Initialize Checkout (بدء الحجز وتوليد Stripe PaymentIntent)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"service_id\": 1,\n    \"booking_type\": \"online\",\n    \"consultation_type\": \"video\",\n    \"date\": \"2026-08-25\",\n    \"start_time\": \"14:30\",\n    \"title\": \"استشارة حول نوبات القلق والتوتر\",\n    \"notes\": \"أفضل الموعد مساءً إن أمكن\",\n    \"name\": \"مستفيد جديد\",\n    \"phone\": \"+9647799887766\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/checkout/initialize",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"checkout",
								"initialize"
							]
						},
						"description": "خطوة 1: اختيار الجلسة والوقت وقناة التواصل وادخال البيانات. تقوم بالتحقق من عدم التعارض وإرجاع client_secret و booking_reference لـ Stripe."
					},
					"response": []
				},
				{
					"name": "Step 2: Confirm Checkout (تأكيد الحجز بعد استكمال الدفع)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"booking_reference\": \"BK-ABC12345\",\n    \"payment_intent_id\": \"pi_3MtwZa2eZvKYlo2C1wXXX\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/checkout/confirm",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"checkout",
								"confirm"
							]
						},
						"description": "خطوة 2: يتم استدعاؤها بعد نجاح عملية الدفع في Stripe لموبايل Flutter. ينشئ حساب المستفيد (إذا كان زائر) ويرجع Token وتأكيد الموعد النهائي."
					},
					"response": []
				}
			]
		},
